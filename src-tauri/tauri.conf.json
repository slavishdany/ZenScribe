{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZenScribe",
  "version": "0.1.0",
  "identifier": "com.zenscribe.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZenScribe",
        "width": 1200,
        "height": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "resources/llamafile-server"
    ]
  }
}
